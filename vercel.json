{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "{admin.html,server/**}"
    }
  },
  "rewrites": [
    { "source": "/adminer", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
